<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityLogsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:padding="20dp">

    <!-- Back Button -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#3026B9"
        android:textSize="40sp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Back to dashboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tvActivityTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Activity Logs"
        android:textColor="#202027"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- Screen Description -->
    <TextView
        android:id="@+id/tvActivitySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Your recent vehicle activities"
        android:textColor="#777780"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvActivityTitle" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearLogs"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Clear Logs"
        android:textColor="#3026B9"
        android:textAllCaps="false"
        app:icon="@drawable/ic_delete"
        app:iconTint="#3026B9"
        app:backgroundTint="#FFFFFF"
        app:strokeColor="#3026B9"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvActivitySubtitle"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Activity List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvActivityLogs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnClearLogs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvEmptyLogs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Activities Yet\nYour vehicle activities will appear here once you start using the controls."
        android:textColor="#777780"
        android:textSize="15sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnClearLogs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
