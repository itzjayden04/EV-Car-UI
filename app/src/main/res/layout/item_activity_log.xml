<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Activity Icon -->
        <TextView
            android:id="@+id/tvActivityIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#F0EEFF"
            android:gravity="center"
            android:text="⚡"
            android:textSize="22sp" />

        <!-- Activity Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActivityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine activated"
                android:textColor="#202027"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActivityTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Today, 10:30 AM"
                android:textColor="#777780"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Activity Status -->
        <TextView
            android:id="@+id/tvActivityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activated"
            android:textColor="#3026B9"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
