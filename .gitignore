
# ==========================================
# 1. Android build outputs
# ==========================================

# Ignore generated build files and compiled outputs.
# These files can be regenerated by Android Studio / Gradle.
**/build/


# ==========================================
# 2. Gradle files
# ==========================================

# Ignore Gradle's local cache and downloaded dependencies.
.gradle/

# Ignore temporary Gradle state.
.gradle-cache/


# ==========================================
# 3. Local machine configuration
# ==========================================

# Ignore the local Android SDK path.
# This file contains a path specific to your computer.
local.properties


# ==========================================
# 4. Android Studio / IntelliJ IDEA
# ==========================================

# Ignore user-specific IDE settings and temporary files.
.idea/caches/
.idea/libraries/
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/usage.statistics.xml

# Ignore IDE deployment target selections.
.idea/deploymentTargetSelector.xml

# Ignore temporary IDE-generated module files.
*.iml


# ==========================================
# 5. Android native build files
# ==========================================

# Ignore generated native build files.
.externalNativeBuild/
.cxx/


# ==========================================
# 6. Generated test and capture files
# ==========================================

# Ignore screenshots and captures generated by development tools.
captures/


# ==========================================
# 7. Operating system files
# ==========================================

# Ignore macOS metadata files.
.DS_Store

# Ignore Windows thumbnail cache files.
Thumbs.db
desktop.ini


# ==========================================
# 8. Signing credentials and private keys
# ==========================================

# Ignore Java / Android signing keystores.
*.jks
*.keystore

# Ignore private key files.
*.pem
*.key


# ==========================================
# 9. Environment variables and secrets
# ==========================================

# Ignore environment configuration files.
.env
.env.*

# Exception: allow a safe example environment file if needed.
!.env.example

# Android Studio project-specific settings
.idea/

# ==========================================
# 10. Temporary files and logs
# ==========================================

# Ignore editor backup and temporary files.
*~
*.tmp
*.temp
*.log


# ==========================================
# 11. Python / automation artifacts (optional)
# ==========================================

# Ignore Python bytecode and cache folders if scripts are added later.
__pycache__/
*.py[cod]

